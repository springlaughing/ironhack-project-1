services:
  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]   # save every vote to disk (fault 4)
    ports: ["6379:6379"]                               # open to A and B; the security group decides who
    volumes: ["/data/redis:/data"]                     # on the data disk
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
    restart: unless-stopped

  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?set in .env}"
    ports: ["5432:5432"]
    volumes: ["/data/postgres:/var/lib/postgresql/data"]   # on the data disk
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
    restart: unless-stopped
